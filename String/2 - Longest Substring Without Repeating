"""
    Finds the length of the longest substring without repeating characters.
    
    Logic:
    1. Use a 'char_map' to store the index of the last time we saw a character.
    2. 'left' marks the start of the current valid (unique) window.
    3. If we see a character again, we move 'left' to skip the old occurrence.
"""

# input - "abcabcbb"
# output - 3
# sliding window concept has been used

def longest_unique(str):
    charSet = set()
    l =0
    res =0

    for r in range(len(str)):
        while str[r] in charSet:
           charSet.remove(str[l])
           l += 1
        charSet.add()

        res = max(res, r-l+1)
    return res

print(longest_unique("abcabcbb"))       # output  = 3
