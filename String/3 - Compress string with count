# input: "aaabb".     output: "a3b2"

def compress(string):
    res = ""
    count = 1
    
    for i in range(1, len(string)):
        if string[i] == string[i-1]:
           count += 1
        else:
            res = res + string[i-1] + str(count)
            count = 1
    
    # for last char add it in res
    res = res + string[-1] + str(count)
    return res
    

print(compress("aaabbcccc"))
print(compress("aaaaa"))
